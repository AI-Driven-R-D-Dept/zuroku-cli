{
  "name": "@zuroku/cli",
  "version": "0.1.6",
  "type": "module",
  "description": "Command-line publisher for zuroku — upload AI-generated graphic-recording HTML + assets to your zuroku instance.",
  "bin": {
    "zuroku": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AI-Driven-R-D-Dept/zuroku-cli.git"
  },
  "homepage": "https://github.com/AI-Driven-R-D-Dept/zuroku-cli#readme",
  "bugs": {
    "url": "https://github.com/AI-Driven-R-D-Dept/zuroku-cli/issues"
  },
  "keywords": [
    "zuroku",
    "cli",
    "publish",
    "claude-code",
    "graphic-recording"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@zuroku/core": "^0.1.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
